{
  "Transform": "AWS::Serverless-2016-10-31",
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Template to Register RDS Read Replica IPs as targets for Network Load Balancer",
  "Parameters": {
    "CodeS3Bucket": {
      "Type": "String",
      "Description": "S3 bucket name where the Lambda deployment package (populate_NLB_TG_with_RDS_RR.zip) is stored"
    },
    "CodeS3Key": {
      "Type": "String",
      "Default": "lambda-code/populate_NLB_TG_with_RDS_RR.zip",
      "Description": "S3 key (path) to the Lambda deployment package"
    },
    "RDSReplicaDNSNames": {
      "Type": "String",
      "Default": "",
      "Description": "Enter comma-separated DNS names of your RDS read replicas. e.g. replica1.abc123.us-east-1.rds.amazonaws.com, replica2.abc123.us-east-1.rds.amazonaws.com"
    },
    "NLBTargetGroupARN": {
      "Type": "String",
      "Default": "",
      "Description": "Enter the target group ARN which you want the RDS read replicas to be registered to"
    },
    "S3BucketName": {
      "Type": "String",
      "Default": "",
      "Description": "Enter the S3 Bucket name that you want to store RDS read replica IP addresses and state"
    },
    "RDSListenerPort": {
      "Type": "Number",
      "Default": 3306,
      "Description": "Enter the traffic listener port of your RDS instances (3306 for MySQL, 5432 for PostgreSQL)"
    },
    "StatePrefix": {
      "Type": "String",
      "Default": "rds-cluster-read-replicas",
      "Description": "Enter the S3 key prefix for state files (e.g., rds-cluster-read-replicas)"
    },
    "CloudWatchLogGroup": {
      "Type": "String",
      "Default": "",
      "Description": "(Optional) Enter the CloudWatch Logs group name. Leave empty to use default Lambda log group"
    },
    "MAXDNSLookupPerInvocation": {
      "Type": "Number",
      "Default": 5,
      "Description": "Please specify the max DNS lookup this function can perform per invocation per DNS name"
    },
    "InvocationBeforeDeregistration": {
      "Type": "Number",
      "Default": 3,
      "Description": "Please specify how many invocations are needed before an IP is deregistered"
    },
    "Region": {
      "Type": "String",
      "Default": "us-west-2",
      "Description": "Please specify the region where you want to create your Lambda function"
    }
  },
  "Resources": {
    "LambdaFunction": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "FunctionName": "RDS-NLB-Registration",
        "CodeUri": {
          "Bucket": {
            "Ref": "CodeS3Bucket"
          },
          "Key": {
            "Ref": "CodeS3Key"
          }
        },
        "Description": "Register RDS Read Replica IPs to Network Load Balancer",
        "Handler": "populate_NLB_TG_with_RDS_RR.lambda_handler",
        "Timeout": 300,
        "Role": {
          "Fn::GetAtt": [
            "LambdaIAMRole",
            "Arn"
          ]
        },
        "Runtime": "python3.13",
        "Environment": {
          "Variables": {
            "RDS_REPLICA_DNS_NAMES": {
              "Ref": "RDSReplicaDNSNames"
            },
            "RDS_LISTENER_PORT": {
              "Ref": "RDSListenerPort"
            },
            "STATE_PREFIX": {
              "Ref": "StatePrefix"
            },
            "CLOUDWATCH_LOG_GROUP": {
              "Ref": "CloudWatchLogGroup"
            },
            "NLB_TG_ARN": {
              "Ref": "NLBTargetGroupARN"
            },
            "S3_BUCKET": {
              "Ref": "S3BucketName"
            },
            "MAX_LOOKUP_PER_INVOCATION": {
              "Ref": "MAXDNSLookupPerInvocation"
            },
            "INVOCATIONS_BEFORE_DEREGISTRATION": {
              "Ref": "InvocationBeforeDeregistration"
            }
          }
        }
      }
    },
    "ScheduledRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "ScheduledRule",
        "ScheduleExpression": "rate(1 minute)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "LambdaFunction",
                "Arn"
              ]
            },
            "Id": "TargetFunctionV1"
          }
        ]
      },
      "DependsOn": [
        "LambdaFunction"
      ]
    },
    "LambdaInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Fn::GetAtt": [
            "LambdaFunction",
            "Arn"
          ]
        },
        "Principal": "events.amazonaws.com",
        "Action": "lambda:InvokeFunction",
        "SourceArn": {
          "Fn::GetAtt": [
            "ScheduledRule",
            "Arn"
          ]
        }
      }
    },
    "LambdaIAMRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Path": "/",
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole",
          {
            "Ref": "LambdaRDSReadReplicaPolicy"
          }
        ]
      }
    },
    "LambdaRDSReadReplicaPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Policy for Lambda to manage RDS read replica NLB registration",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "LambdaLogging",
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                "arn:aws:logs:*:*:*"
              ]
            },
            {
              "Sid": "S3",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:s3:::${S3BucketName}"
                },
                {
                  "Fn::Sub": "arn:aws:s3:::${S3BucketName}/*"
                }
              ]
            },
            {
              "Sid": "ELB",
              "Effect": "Allow",
              "Action": [
                "elasticloadbalancing:DescribeTargetHealth",
                "elasticloadbalancing:RegisterTargets",
                "elasticloadbalancing:DeregisterTargets"
              ],
              "Resource": {
                "Ref": "NLBTargetGroupARN"
              }
            }
          ]
        }
      }
    }
  }
}